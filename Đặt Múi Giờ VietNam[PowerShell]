# 1. Đặt Múi Giờ Việt Nam (Bangkok, Hanoi, Jakarta)
tzutil /s "SE Asia Standard Time"

# 2. Reset Service Windown Time
net stop w32time
w32tm /unregister
w32tm /register
net start w32time

# 3. Sync
w32tm /config /manualpeerlist:"://google.com time.nist.gov sg.pool.ntp.org" /syncfromflags:manual /update

# 4. Windown Reset Time Now
w32tm /resync /force
